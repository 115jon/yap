<?xml version="1.0"?>
<!-- Qt 6.11's template (src/android/templates) with these changes:
     the predictive back gesture on (the shim registers its callback while
     there is a page to go back to; at the root the system plays its own
     back-to-home preview when it keeps the task alive, see
     NativeShim.keepsTaskAtRoot), the keyboard left to the app (adjustNothing:
     the composer follows the IME inset itself, frame by frame), the
     session file kept out of cloud backup and device-to-device transfer,
     the adaptive icon, and the splash: the theme's (system splash on
     Android 12+, window background before) hands over to Qt's, which stays
     until main.cpp hides it at the first frame; push notifications
     (the FCM service, the Reply and Mark as read receiver, the permission);
     and voice calls (the mic, the audio route, the call's service).
     No package attribute: the application id is CMake's YAP_ANDROID_APP_ID
     (Gradle's namespace). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Message notifications (API 33+ asks; push/PushShim, Native). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice calls (voice/VoiceShim): the mic (asked at the first join);
         the communication mode and the speaker, earpiece or headset route;
         the call's foreground service, which keeps the call with the screen
         off or the app in the background; and the proximity sensor's screen
         lock while the earpiece plays. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- The shim asks which app is the home screen (was this start the
         launcher's? NativeShim.keepsTaskAtRoot). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="Yap"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name="dev.yap.qtproto.YapActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="Yap"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:theme="@style/YapTheme"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

            <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />

            <meta-data
                android:name="android.app.splash_screen_drawable"
                android:resource="@drawable/splash" />
            <meta-data
                android:name="android.app.splash_screen_sticky"
                android:value="true" />
            <!-- Qt's event loops keep running while the app is in the
                 background. Without it Qt stops them there (QtLoader sets
                 QT_BLOCK_EVENT_LOOPS_WHEN_SUSPENDED, read once at start, so
                 it cannot be turned on for a call only), and the core's view
                 updates wait for the Qt thread: over a call with the screen
                 off they pile up and are all applied on return (README,
                 "Voice calls"). Nothing draws meanwhile (the window is not
                 exposed), and outside a call the gateway closes after its
                 grace as before. -->
            <meta-data
                android:name="android.app.background_running"
                android:value="true" />
        </activity>

        <!-- Yap's data-only pushes, drawn natively (push/MessageNotifier),
             also with the app killed. -->
        <service
            android:name="dev.yap.qtproto.push.YapMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- The call in progress: the ongoing notification with Mute and
             Leave. Not restarted by the system: the call lives in the
             process, and ends with it. -->
        <service
            android:name="dev.yap.qtproto.voice.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />
        <!-- A notification's Reply and Mark as read. -->
        <receiver
            android:name="dev.yap.qtproto.push.NotificationActionReceiver"
            android:exported="false" />
        <!-- What FCM uses for a push it draws itself (none of Yap's do). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="other" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/yap_notify_small" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/yap_accent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>
    </application>
</manifest>
