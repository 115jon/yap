<?xml version="1.0" encoding="utf-8"?>
<!-- The themed-icon layer (Android 13+): the foreground's shape in one
     color; the launcher tints it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="31"
        android:translateY="31"
        android:scaleX="1.4375"
        android:scaleY="1.4375">
        <path
            android:fillColor="#ffffff"
            android:pathData="@string/yap_mark_cut" />
    </group>
</vector>
