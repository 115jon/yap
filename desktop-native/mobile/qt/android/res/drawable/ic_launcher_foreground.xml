<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's foreground: the mark 46 dp across in the 108 dp
     canvas (the 66 dp safe zone keeps it whole under every mask), its eye,
     ear and nose cut out so the background shows through. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="31"
        android:translateY="31"
        android:scaleX="1.4375"
        android:scaleY="1.4375">
        <path
            android:fillColor="#ff3d8b"
            android:pathData="@string/yap_mark_cut" />
    </group>
</vector>
