+// Yap patch: subpixel (Format_A32) text as Chromium draws it. Skia does not
+// blend DirectWrite's raw coverage as is: it first runs it through a
+// per-colour table (SkTMaskGamma_build_correcting_lut) so that the plain
+// blend that follows looks like a blend in linear light, with a contrast
+// boost. Without it light text on a dark ground is thin and dark text on a
+// light one heavy. 24bittextmask.frag computes that table per fragment from
+// the text colour. Chromium falls back to grayscale where subpixel coverage
+// would fringe; so does this: into a translucent target (a layer), under a
+// scale or rotation, and when ClearType is off.
+//   QSG_TEXT_CONTRAST    Skia's contrast (default 1.0, Chromium's)
+//   QSG_TEXT_GAMMA       the gamma; 0 (default) is the sRGB curve, Skia's
+//   QSG_TEXT_PREBLEND=0  blends the raw coverage (Qt's own behaviour)
+//   QSG_TEXT_GRAYSCALE=1 grayscale everywhere (ClearType off)
+struct QSGYapTextSettings
+{
+    float contrast = 1.0f;
+    float gamma = 0.0f;
+    bool preblend = true;
+    bool grayscale = false;
+};
+
+static const QSGYapTextSettings &qsg_yapTextSettings()
+{
+    static const QSGYapTextSettings settings = [] {
+        QSGYapTextSettings s;
+        bool ok = false;
+        float v = qEnvironmentVariable("QSG_TEXT_CONTRAST").toFloat(&ok);
+        if (ok)
+            s.contrast = qBound(0.0f, v, 10.0f);
+        v = qEnvironmentVariable("QSG_TEXT_GAMMA").toFloat(&ok);
+        if (ok)
+            s.gamma = v >= 1.0f ? qMin(v, 5.0f) : 0.0f;
+        if (qEnvironmentVariableIsSet("QSG_TEXT_PREBLEND"))
+            s.preblend = qEnvironmentVariableIntValue("QSG_TEXT_PREBLEND") != 0;
+        s.grayscale = qEnvironmentVariableIntValue("QSG_TEXT_GRAYSCALE") != 0;
+        return s;
+    }();
+    return settings;
+}
