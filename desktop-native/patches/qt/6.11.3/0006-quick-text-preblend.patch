+vec3 yapToLinear(vec3 v, float g)
+{
+    if (g > 0.0)
+        return pow(v, vec3(g));
+    return mix(v / 12.92, pow((v + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), v));
+}
+
+vec3 yapFromLinear(vec3 v, float g)
+{
+    v = clamp(v, 0.0, 1.0);
+    if (g > 0.0)
+        return pow(v, vec3(1.0 / g));
+    return mix(v * 12.92, 1.055 * pow(v, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), v));
+}
+
+// Skia's SkTMaskGamma_build_correcting_lut, per channel: the coverage that,
+// blended plainly, gives what blending in linear light (gamma g) with the
+// contrast boost would. The text colour is Skia's canonical luminance colour
+// (3 bits a channel) and the ground is guessed as its inverse, as in Skia.
+vec3 yapPreblend(vec3 a, vec3 textColor)
+{
+    vec3 q = floor(floor(textColor * 255.0 + 0.5) / 32.0);
+    vec3 src = (q * 36.0 + floor(q / 2.0)) / 255.0;
+    vec3 dst = 1.0 - src;
+    vec3 linSrc = yapToLinear(src, yapText.y);
+    vec3 linDst = yapToLinear(dst, yapText.y);
+    vec3 s = a + (1.0 - a) * (yapText.x * linDst) * a;
+    vec3 wanted = yapFromLinear(linSrc * s + (1.0 - s) * linDst, yapText.y);
+    vec3 d = src - dst;
+    vec3 level = step(abs(d), vec3(1.0 / 256.0));
+    vec3 r = (wanted - dst) / mix(d, vec3(1.0), level);
+    return clamp(mix(r, s, level), 0.0, 1.0);
+}
