+// The app's UI device, for decoders configured from now on (nullptr: each
+// stream makes its own device again and reads its pictures back). It must
+// have video support and multithread protection.
+extern "C" void yap_mf_set_shared_device(void* device) {
+  std::lock_guard<std::mutex> lock(livekit_ffi::g_shared_mutex);
+  livekit_ffi::g_shared_device = static_cast<ID3D11Device*>(device);
+}
+
+// A frame's texture, if `frame` (a livekit_ffi::VideoFrameBuffer, as Rust's
+// NativeBuffer holds it) is one of ours. `hold` keeps the frame, and with it
+// the texture, until `release(hold)`. The layout is repeated in
+// cpp/videohub.cpp.
+struct YapD3D11Frame {
+  void* texture;  // ID3D11Texture2D*: NV12, on the shared device
+  int width;
+  int height;
+  void* hold;
+  void (*release)(void* hold);
+};
+
+extern "C" bool yap_d3d11_frame(const void* frame, YapD3D11Frame* out) {
+  if (!frame || !out)
+    return false;
+  webrtc::scoped_refptr<webrtc::VideoFrameBuffer> buffer =
+      static_cast<const livekit_ffi::VideoFrameBuffer*>(frame)->get();
+  if (!buffer || buffer->type() != webrtc::VideoFrameBuffer::Type::kNative ||
+      buffer->storage_representation() != livekit_ffi::kD3D11Nv12)
+    return false;
+  auto* nv12 = static_cast<livekit_ffi::D3D11Nv12Buffer*>(buffer.get());
+  out->texture = nv12->texture();
+  out->width = nv12->width();
+  out->height = nv12->height();
+  out->hold = buffer.release();
+  out->release = [](void* hold) { static_cast<webrtc::VideoFrameBuffer*>(hold)->Release(); };
+  return true;
+}
