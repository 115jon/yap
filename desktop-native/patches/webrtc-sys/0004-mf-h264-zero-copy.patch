+constexpr char kD3D11Nv12[] = "yap-d3d11-nv12";
+
+// Textures of one size for one stream's decoded pictures. A texture goes
+// back when the last frame holding it is released; the pool outlives its
+// decoder while frames are still shown.
+class TexturePool {
+ public:
+  TexturePool(ComPtr<ID3D11Device> device, int width, int height)
+      : device_(std::move(device)), width_(width), height_(height) {}
+
+  int width() const { return width_; }
+  int height() const { return height_; }
+  ID3D11Device* device() const { return device_.Get(); }
+
+  ComPtr<ID3D11Texture2D> Take() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!free_.empty()) {
+        ComPtr<ID3D11Texture2D> texture = std::move(free_.back());
+        free_.pop_back();
+        return texture;
+      }
+    }
+    D3D11_TEXTURE2D_DESC desc{};
+    desc.Width = UINT(width_);
+    desc.Height = UINT(height_);
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = DXGI_FORMAT_NV12;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    ComPtr<ID3D11Texture2D> texture;
+    if (FAILED(device_->CreateTexture2D(&desc, nullptr, &texture)))
+      return nullptr;
+    return texture;
+  }
+
+  void Give(ComPtr<ID3D11Texture2D> texture) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    // A few spare; more were only needed for a burst.
+    if (texture && free_.size() < 4)
+      free_.push_back(std::move(texture));
+  }
+
+ private:
+  ComPtr<ID3D11Device> device_;
+  const int width_;
+  const int height_;
+  std::mutex mutex_;
+  std::vector<ComPtr<ID3D11Texture2D>> free_;
+};
+
+// One decoded picture as an NV12 texture on the shared device.
+class D3D11Nv12Buffer : public webrtc::VideoFrameBuffer {
+ public:
+  D3D11Nv12Buffer(ComPtr<ID3D11Texture2D> texture, std::shared_ptr<TexturePool> pool)
+      : texture_(std::move(texture)), pool_(std::move(pool)) {}
+  ~D3D11Nv12Buffer() override { pool_->Give(std::move(texture_)); }
+
+  Type type() const override { return Type::kNative; }
+  int width() const override { return pool_->width(); }
+  int height() const override { return pool_->height(); }
+  std::string storage_representation() const override { return kD3D11Nv12; }
+  ID3D11Texture2D* texture() const { return texture_.Get(); }
+
+  // For a consumer that needs the pixels: a staging copy, read back.
+  webrtc::scoped_refptr<webrtc::I420BufferInterface> ToI420() override {
+    D3D11_TEXTURE2D_DESC desc{};
+    texture_->GetDesc(&desc);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    desc.MiscFlags = 0;
+    ComPtr<ID3D11Texture2D> staging;
+    if (FAILED(pool_->device()->CreateTexture2D(&desc, nullptr, &staging)))
+      return nullptr;
+    ComPtr<ID3D11DeviceContext> context;
+    pool_->device()->GetImmediateContext(&context);
+    context->CopyResource(staging.Get(), texture_.Get());
+    D3D11_MAPPED_SUBRESOURCE mapped{};
+    if (FAILED(context->Map(staging.Get(), 0, D3D11_MAP_READ, 0, &mapped)))
+      return nullptr;
+    webrtc::scoped_refptr<webrtc::I420Buffer> i420 =
+        webrtc::I420Buffer::Create(width(), height());
+    const uint8_t* y = static_cast<const uint8_t*>(mapped.pData);
+    libyuv::NV12ToI420(y, int(mapped.RowPitch), y + size_t(mapped.RowPitch) * desc.Height,
+                       int(mapped.RowPitch), i420->MutableDataY(), i420->StrideY(),
+                       i420->MutableDataU(), i420->StrideU(), i420->MutableDataV(),
+                       i420->StrideV(), width(), height());
+    context->Unmap(staging.Get(), 0);
+    return i420;
+  }
+
+ private:
+  ComPtr<ID3D11Texture2D> texture_;
+  std::shared_ptr<TexturePool> pool_;
+};
