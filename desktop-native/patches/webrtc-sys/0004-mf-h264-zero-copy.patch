+  // The decoded picture (a slice of the decoder's texture array) copied on
+  // the GPU into a texture of our own, so the decoder gets its surface back
+  // at once and the UI can sample the copy.
+  webrtc::scoped_refptr<webrtc::VideoFrameBuffer> CopyToTexture(IMFMediaBuffer* buffer) {
+    ComPtr<IMFDXGIBuffer> dxgi;
+    if (FAILED(buffer->QueryInterface(IID_PPV_ARGS(&dxgi))))
+      return nullptr;
+    ComPtr<ID3D11Texture2D> source;
+    UINT index = 0;
+    if (FAILED(dxgi->GetResource(IID_PPV_ARGS(&source))) ||
+        FAILED(dxgi->GetSubresourceIndex(&index)))
+      return nullptr;
+    // NV12 needs even sizes.
+    const int width = (width_ + 1) & ~1;
+    const int height = (height_ + 1) & ~1;
+    D3D11_TEXTURE2D_DESC desc{};
+    source->GetDesc(&desc);
+    if (desc.Format != DXGI_FORMAT_NV12 || UINT(width) > desc.Width || UINT(height) > desc.Height)
+      return nullptr;
+    if (!textures_ || textures_->width() != width || textures_->height() != height)
+      textures_ = std::make_shared<TexturePool>(gpu_device_.device, width, height);
+    ComPtr<ID3D11Texture2D> texture = textures_->Take();
+    if (!texture)
+      return nullptr;
+    if (!context_)
+      gpu_device_.device->GetImmediateContext(&context_);
+    const D3D11_BOX box{0, 0, 0, UINT(width), UINT(height), 1};
+    context_->CopySubresourceRegion(texture.Get(), 0, 0, 0, 0, source.Get(), index, &box);
+    return webrtc::make_ref_counted<D3D11Nv12Buffer>(std::move(texture), textures_);
+  }
