+bool MfVpxHardwareAvailable(webrtc::VideoCodecType codec) {
+  // Once per codec: does the MFT exist, and does it take the codec with a
+  // D3D11 device manager (DXVA for it on this GPU)? It is asked when the
+  // first stream of the codec arrives, after the UI registered its device.
+  auto probe = [codec] {
+    if (VpxSoftwareRequested() || SoftwareRequested())
+      return false;
+    CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+    if (FAILED(MFStartup(MF_VERSION, MFSTARTUP_NOSOCKET)))
+      return false;
+    ComPtr<IMFTransform> mft;
+    if (FAILED(CreateMft(codec, mft)))
+      return false;
+    ComPtr<IMFAttributes> attributes;
+    UINT32 aware = 0;
+    GpuDevice gpu;
+    bool ok = SUCCEEDED(mft->GetAttributes(&attributes)) &&
+              SUCCEEDED(attributes->GetUINT32(MF_SA_D3D11_AWARE, &aware)) && aware &&
+              MakeGpuDevice(gpu) &&
+              SUCCEEDED(mft->ProcessMessage(MFT_MESSAGE_SET_D3D_MANAGER,
+                                            reinterpret_cast<ULONG_PTR>(gpu.manager.Get())));
+    if (ok) {
+      ComPtr<IMFMediaType> input;
+      MFCreateMediaType(&input);
+      input->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+      input->SetGUID(MF_MT_SUBTYPE, InputSubtype(codec));
+      MFSetAttributeSize(input.Get(), MF_MT_FRAME_SIZE, 1280, 720);
+      ok = SUCCEEDED(mft->SetInputType(0, input.Get(), 0));
+    }
+    mft->ProcessMessage(MFT_MESSAGE_SET_D3D_MANAGER, 0);
+    RTC_LOG(LS_INFO) << CodecTag(codec)
+                     << (ok ? " the GPU decodes it through Media Foundation"
+                            : " no GPU decoder through Media Foundation: libvpx");
+    return ok;
+  };
+  if (codec == webrtc::kVideoCodecVP8) {
+    static const bool vp8 = probe();
+    return vp8;
+  }
+  if (codec == webrtc::kVideoCodecVP9) {
+    static const bool vp9 = probe();
+    return vp9;
+  }
+  return false;
+}
+
+std::unique_ptr<webrtc::VideoDecoder> CreateMfVpxDecoder(webrtc::VideoCodecType codec) {
+  return std::make_unique<MfH264Decoder>(codec);
+}
