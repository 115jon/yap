+// YAP_VPX_DECODER=software: VP8 and VP9 stay on libvpx (comparisons).
+bool VpxSoftwareRequested() {
+  const char* value = std::getenv("YAP_VPX_DECODER");
+  return value != nullptr && std::strcmp(value, "software") == 0;
+}
+
+const char* CodecTag(webrtc::VideoCodecType codec) {
+  switch (codec) {
+    case webrtc::kVideoCodecVP8:
+      return "[mf-vp8]";
+    case webrtc::kVideoCodecVP9:
+      return "[mf-vp9]";
+    default:
+      return "[mf-h264]";
+  }
+}
+
+GUID InputSubtype(webrtc::VideoCodecType codec) {
+  switch (codec) {
+    case webrtc::kVideoCodecVP8:
+      return MFVideoFormat_VP80;
+    case webrtc::kVideoCodecVP9:
+      return MFVideoFormat_VP90;
+    default:
+      return MFVideoFormat_H264;
+  }
+}
+
+// The decoder MFT for `codec`: Windows' own H.264 decoder, or the first
+// registered decoder for VP8/VP9 (the VP9 Video Extensions' MFT).
+HRESULT CreateMft(webrtc::VideoCodecType codec, ComPtr<IMFTransform>& out) {
+  if (codec == webrtc::kVideoCodecH264)
+    return CoCreateInstance(CLSID_MSH264DecoderMFT, nullptr, CLSCTX_INPROC_SERVER,
+                            IID_PPV_ARGS(&out));
+  MFT_REGISTER_TYPE_INFO input{MFMediaType_Video, InputSubtype(codec)};
+  IMFActivate** activates = nullptr;
+  UINT32 count = 0;
+  HRESULT hr = MFTEnumEx(MFT_CATEGORY_VIDEO_DECODER,
+                         MFT_ENUM_FLAG_SYNCMFT | MFT_ENUM_FLAG_LOCALMFT |
+                             MFT_ENUM_FLAG_SORTANDFILTER,
+                         &input, nullptr, &activates, &count);
+  if (FAILED(hr))
+    return hr;
+  hr = count ? activates[0]->ActivateObject(IID_PPV_ARGS(&out)) : MF_E_TOPO_CODEC_NOT_FOUND;
+  for (UINT32 i = 0; i < count; ++i)
+    activates[i]->Release();
+  CoTaskMemFree(activates);
+  return hr;
+}
