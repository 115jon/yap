<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged into YapNative.exe by the linker (CMake lists it as a source).
     Per-monitor v2 DPI awareness from the first instruction, before Qt
     (which would otherwise set it at QGuiApplication), so every window,
     the WebView2 hosts and the crash notice scale per monitor. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <!-- The segment heap (Windows 10 2004+) for every heap of the
           process: it gives freed memory back to the system, where the
           default NT heap kept ~20 MB of freed blocks committed at idle
           (docs/PERFORMANCE.md, pass 3). -->
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
