// The executable icon (Explorer, the taskbar before Qt sets one): the
// desktop app's mark, copied from desktop/src-tauri/icons/icon.ico.
IDI_ICON1 ICON "../assets/app/yap.ico"

// The name Windows shows for the process (Task Manager, the toast
// settings, "Open with"): Yap. CMakeLists.txt passes the version.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION YAP_VERSION_MAJOR,YAP_VERSION_MINOR,YAP_VERSION_PATCH,0
 PRODUCTVERSION YAP_VERSION_MAJOR,YAP_VERSION_MINOR,YAP_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "115jon"
      VALUE "FileDescription", "Yap"
      VALUE "FileVersion", YAP_VERSION_STRING
      VALUE "InternalName", "Yap"
      VALUE "OriginalFilename", "Yap.exe"
      VALUE "ProductName", "Yap"
      VALUE "ProductVersion", YAP_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
