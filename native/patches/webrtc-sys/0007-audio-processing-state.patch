+// Yap patch (native/patches/webrtc-sys): per component, what runs
+// (sw: WebRTC's APM, hw: the platform's effect, sw+hw, off) and how it got
+// there: req is the track's request, sw the APM's live config, hw the
+// platform effect (avail/active). "?" is unknown.
+rust::String PeerConnectionFactory::audio_processing_state() const {
+  webrtc::AudioProcessingState state = peer_factory_->GetAudioProcessingState();
+  auto flag = [](const std::optional<bool>& v) -> const char* {
+    return !v.has_value() ? "?" : *v ? "1" : "0";
+  };
+  auto effective = [](webrtc::AudioProcessingImplementation i) -> const char* {
+    switch (i) {
+      case webrtc::AudioProcessingImplementation::kDisabled:
+        return "off";
+      case webrtc::AudioProcessingImplementation::kSoftware:
+        return "sw";
+      case webrtc::AudioProcessingImplementation::kPlatform:
+        return "hw";
+      case webrtc::AudioProcessingImplementation::kSoftwareAndPlatform:
+        return "sw+hw";
+      default:
+        return "?";
+    }
+  };
+  auto component = [&](const char* name,
+                       const webrtc::AudioProcessingComponentState& c) {
+    return std::string(name) + "=" + effective(c.effective) + "(req " +
+           flag(c.requested_enabled) + " sw " + flag(c.software_active) +
+           " hw " + (c.platform_available ? "avail/" : "none/") +
+           flag(c.platform_active) + ")";
+  };
+  std::string line = std::string("apm ") +
+                     (state.has_audio_processing_module ? "yes" : "no") + " " +
+                     component("aec", state.echo_cancellation) + " " +
+                     component("ns", state.noise_suppression) + " " +
+                     component("agc", state.auto_gain_control) + " " +
+                     component("hpf", state.high_pass_filter);
+  return rust::String(line);
+}
+
